    case 0x12: return "VCONN recovery timeout";
    default: return "Unknown";
  }
}

static const char *tpsSoftResetStr(uint8_t v) {
  switch (v) {
    case 0x00: return "None";
    case 0x01: return "Received from partner";
    case 0x04: return "Invalid source caps";
    case 0x05: return "Message retries exhausted";
    case 0x06: return "Unexpected accept";
    case 0x07: return "Unexpected control msg";
    case 0x08: return "Unexpected GetSinkCap";
    case 0x09: return "Unexpected GetSourceCap";
    case 0x0A: return "Unexpected GotoMin";
    case 0x0B: return "Unexpected PS_RDY";
    case 0x0C: return "Unexpected Ping";
    case 0x0D: return "Unexpected Reject";
    case 0x0E: return "Unexpected Request";
    case 0x0F: return "Unexpected Sink Caps";
    case 0x10: return "Unexpected Source Caps";
    case 0x11: return "Unexpected Swap";
    case 0x12: return "Unexpected Wait Caps";
    case 0x13: return "Unknown control msg";
    case 0x14: return "Unknown data msg";
    case 0x15: return "Init SOP'";
    case 0x16: return "Init SOP''";
    case 0x17: return "Unexpected Extended";
    case 0x18: return "Unknown Extended";
    case 0x19: return "Unexpected data msg";
    case 0x1A: return "Unexpected Not Supported";
    case 0x1B: return "Unexpected Get_Status";
    default: return "Reserved";
  }
}

static void printTpsBootFlags() {
  uint8_t buf[8] = {0};
  uint8_t actual = 0;
  if (!readTpsRegister(0x2D, buf, 5, actual) || actual < 5) {
    Serial.println("  BOOT_FLAGS: read error");
    return;
  }

  uint64_t flags = leBytesToU64(buf, 5);
  uint8_t patchSource = (flags >> 29) & 0x07;
  uint8_t revisionId = (flags >> 32) & 0xFF;

  const char *patchSourceStr = "Unknown";
  switch (patchSource) {
    case 0x00: patchSourceStr = "None"; break;
    case 0x05: patchSourceStr = "EEPROM"; break;
    case 0x06: patchSourceStr = "I2C"; break;
    default: patchSourceStr = "Reserved"; break;
  }

  Serial.print("  BOOT_FLAGS: ");
  printHexBytes(buf, 5);
  Serial.println();
  Serial.printf("    RevisionID=0x%02X PatchSource=%s\n", revisionId, patchSourceStr);
  Serial.printf("    EEPROM_Present=%u Region0_Attempted=%u Region1_Attempted=%u\n",
                (uint8_t)((flags >> 3) & 0x01),
                (uint8_t)((flags >> 4) & 0x01),
                (uint8_t)((flags >> 5) & 0x01));
  Serial.printf("    Region0_Invalid=%u Region1_Invalid=%u Region0_EEPROM_Err=%u Region1_EEPROM_Err=%u\n",
                (uint8_t)((flags >> 6) & 0x01),
                (uint8_t)((flags >> 7) & 0x01),
                (uint8_t)((flags >> 8) & 0x01),
                (uint8_t)((flags >> 9) & 0x01));
  Serial.printf("    PatchDL_Error=%u Region0_CRC_Fail=%u Region1_CRC_Fail=%u PatchHeader_Error=%u\n",
                (uint8_t)((flags >> 10) & 0x01),
                (uint8_t)((flags >> 12) & 0x01),
                (uint8_t)((flags >> 13) & 0x01),
                (uint8_t)(flags & 0x01));
  Serial.printf("    DeadBattery=%u SystemTSD=%u\n",
                (uint8_t)((flags >> 2) & 0x01),
                (uint8_t)((flags >> 19) & 0x01));
}

static void printBqStatus() {
  uint8_t regs[7] = {0};
  for (uint8_t i = 0; i < 7; ++i) {
    if (!readBqReg((uint8_t)(0x1B + i), regs[i])) {
      Serial.printf("  read error (REG0x%02X)\n", (uint8_t)(0x1B + i));
      return;
    }
  }
  printBqStatusFromRegs(regs, sizeof(regs));

  uint16_t ibus = 0;
  uint16_t ibat = 0;
  uint16_t vbus = 0;
  uint16_t vac1 = 0;
  uint16_t vac2 = 0;
  uint16_t vbat = 0;
  uint16_t vsys = 0;
  if (readBqReg16(0x31, ibus) &&
      readBqReg16(0x33, ibat) &&
      readBqReg16(0x35, vbus) &&
      readBqReg16(0x37, vac1) &&
      readBqReg16(0x39, vac2) &&
      readBqReg16(0x3B, vbat) &&
      readBqReg16(0x3D, vsys)) {
    Serial.println("  ADC:");
    Serial.printf("    VBAT=%u mV VSYS=%u mV VBUS=%u mV VAC1=%u mV VAC2=%u mV\n",
                  vbat, vsys, vbus, vac1, vac2);
    Serial.printf("    IBAT=%u mA IBUS=%u mA\n", ibat, ibus);
  } else {
    Serial.println("  ADC: read error");
  }

  uint8_t reg2e = 0;
  uint8_t reg2f = 0;
  uint8_t reg30 = 0;
  if (readBqReg(0x2E, reg2e) && readBqReg(0x2F, reg2f) && readBqReg(0x30, reg30)) {
    Serial.printf("  ADC_CTRL: REG2E=0x%02X REG2F=0x%02X REG30=0x%02X\n", reg2e, reg2f, reg30);
    if ((reg2e & 0x80) == 0) {
      Serial.println("  ADC note: ADC_EN=0 (ADC disabled).");
    }
  }
}

static void printTpsStatus() {
  uint8_t buf[16] = {0};
  uint8_t actual = 0;

  Serial.printf("TPS25751 (0x%02X):\n", tpsAddr);

  if (readTpsRegister(0x03, buf, 4, actual) && actual >= 4) {
    char modeAscii[5] = {0};
    for (int i = 0; i < 4; ++i) {
      char c = (char)buf[i];
      modeAscii[i] = isprint((int)c) ? c : '.';
    }
    Serial.print("  MODE: ");
    printHexBytes(buf, 4);
    Serial.printf(" (\"%s\")\n", modeAscii);
  } else if (readTpsRegisterRaw(0x03, buf, 4)) {
    char modeAscii[5] = {0};
    for (int i = 0; i < 4; ++i) {
      char c = (char)buf[i];
      modeAscii[i] = isprint((int)c) ? c : '.';
    }
    Serial.print("  MODE: ");
    printHexBytes(buf, 4);
    Serial.printf(" (\"%s\")\n", modeAscii);
  } else {
    Serial.println("  MODE: read error");
  }

  // Boot flags are accessible even in BOOT/PTCH modes.
  printTpsBootFlags();

  if (readTpsRegister(0x1A, buf, 5, actual) && actual >= 5) {
    uint64_t status = leBytesToU64(buf, 5);
    Serial.print("  STATUS: ");
    printHexBytes(buf, 5);
    Serial.println();
    Serial.printf("    PlugPresent=%u ConnState=%s Orientation=%u PortRole=%s DataRole=%s\n",
                  (uint8_t)(status & 0x01),
                  tpsConnStateStr((status >> 1) & 0x07),
                  (uint8_t)((status >> 4) & 0x01),
                  ((status >> 5) & 0x01) ? "Source" : "Sink",
                  ((status >> 6) & 0x01) ? "DFP" : "UFP");
    Serial.printf("    VBUS=%s USBHost=%s Legacy=%s BIST=%u SoC_Timeout=%u\n",
                  tpsVbusStatusStr((status >> 20) & 0x03),
                  tpsUsbHostStr((status >> 22) & 0x03),
                  tpsLegacyStr((status >> 24) & 0x03),
                  (uint8_t)((status >> 27) & 0x01),
                  (uint8_t)((status >> 30) & 0x01));
  } else {
    Serial.println("  STATUS: read error");
  }

  if (readTpsRegister(0x3F, buf, 2, actual) && actual >= 2) {
    uint16_t pwr = (uint16_t)leBytesToU64(buf, 2);
    Serial.print("  POWER_STATUS: ");
    printHexBytes(buf, 2);
    Serial.println();
    Serial.printf("    PowerConn=%u SourceSink=%s TypeC_Current=%s\n",
                  pwr & 0x01,
                  ((pwr >> 1) & 0x01) ? "Source" : "Sink",
                  tpsTypecCurrentStr((pwr >> 2) & 0x03));
    Serial.printf("    ChargerDetect=%u ChargerAdvertise=%u\n",
                  (pwr >> 4) & 0x0F,
                  (pwr >> 8) & 0x03);
  } else {
    Serial.println("  POWER_STATUS: read error");
  }

  if (readTpsRegister(0x40, buf, 4, actual) && actual >= 4) {
    uint32_t pd = (uint32_t)leBytesToU64(buf, 4);
    Serial.print("  PD_STATUS: ");
    printHexBytes(buf, 4);
    Serial.println();
    Serial.printf("    PresentPDRole=%s PortType=%s CCPullup=%s\n",
                  ((pd >> 6) & 0x01) ? "Source" : "Sink",
                  tpsPortTypeStr((pd >> 4) & 0x03),
                  tpsCcPullupStr((pd >> 2) & 0x03));
    Serial.printf("    HardReset=%s SoftReset=%s\n",
                  tpsHardResetStr((pd >> 16) & 0x3F),
                  tpsSoftResetStr((pd >> 8) & 0x1F));
  } else {
    Serial.println("  PD_STATUS: read error");
  }

  if (readTpsRegister(0x69, buf, 4, actual) && actual >= 4) {
    uint32_t tc = (uint32_t)leBytesToU64(buf, 4);
    uint8_t portState = (tc >> 24) & 0xFF;
    uint8_t cc2 = (tc >> 16) & 0xFF;
    uint8_t cc1 = (tc >> 8) & 0xFF;
    uint8_t ccPd = tc & 0xFF;
    Serial.print("  TYPEC_STATE: ");
    printHexBytes(buf, 4);
    Serial.println();
    Serial.printf("    PortState=%s (0x%02X)\n", tpsTypecPortStateStr(portState), portState);
    Serial.printf("    CC1=%s CC2=%s PD_CC=%s\n",
                  tpsCcPinStateStr(cc1),
                  tpsCcPinStateStr(cc2),
                  tpsPdCcPinStr(ccPd));
  } else {
    Serial.println("  TYPEC_STATE: read error");
  }

  if (readTpsRegister(0x6A, buf, 13, actual) && actual >= 13) {
    Serial.print("  ADC_RESULTS: ");
    printHexBytes(buf, 13);
    Serial.println();
    const float v_adc = 0.014f;
    const float v_vbus = 0.098f;
    const float i_ivbus = 0.0165f;
    float adcin1 = buf[0] * v_adc;
    float adcin2 = buf[1] * v_adc;
    float ldo3v3 = buf[2] * v_adc;
    float vbus1 = buf[3] * v_vbus;
    float ivbus1 = buf[5] * i_ivbus;
    float ivbus1_mean = buf[11] * i_ivbus;
    Serial.printf("    ADCIN1=%.3fV ADCIN2=%.3fV LDO3V3=%.3fV VBUS1=%.3fV\n",
                  adcin1, adcin2, ldo3v3, vbus1);
    Serial.printf("    IVBUS1=%.3fA IVBUS1_MEAN=%.3fA\n", ivbus1, ivbus1_mean);
  } else {
    Serial.println("  ADC_RESULTS: read error");
  }
}

void setup() {
  Serial.begin(115200);
  delay(1500);

  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN, I2C_CLOCK_HZ);

  if (ENABLE_I2C_SCAN) {
    scanI2CBus();
  }

  if (AUTO_DETECT_TPS25751) {
    tpsPresent = false;
    for (size_t i = 0; i < sizeof(TPS25751_ADDR_CANDIDATES); ++i) {
      uint8_t addr = TPS25751_ADDR_CANDIDATES[i];
      if (probeAddress(addr)) {
        tpsAddr = addr;
        tpsPresent = true;
        break;
      }
    }
  } else {
    tpsPresent = probeAddress(tpsAddr);
  }

  bqPresent = probeAddress(BQ25792_ADDR);

  Serial.printf("TPS25751 %s at 0x%02X\n", tpsPresent ? "found" : "not found", tpsAddr);
  Serial.printf("BQ25792 %s at 0x%02X\n", bqPresent ? "found" : "not found", BQ25792_ADDR);
  if (ENABLE_LOW_REGION_PROVISION) {
    Serial.println("Provisioning: send 'P' over Serial to push low-region patch.");
  }
  Serial.println("Status output toggles: 'T' = TPS, 'B' = BQ (default off).");

  if (PROBE_EEPROM) {
    uint8_t buf[EEPROM_PROBE_LEN] = {0};
    if (probeAddress(EEPROM_ADDR) &&
        readEepromBytes(EEPROM_ADDR, EEPROM_PROBE_ADDR, buf, sizeof(buf))) {
      Serial.printf("EEPROM 0x%02X @0x%04X: ", EEPROM_ADDR, EEPROM_PROBE_ADDR);
      printHexBytes(buf, sizeof(buf));
      Serial.println();
    } else {
      Serial.printf("EEPROM 0x%02X: not detected/readable\n", EEPROM_ADDR);
    }
  }

  if (ENABLE_LOW_REGION_PROVISION && PROVISION_ON_BOOT) {
    provisionLowRegionPatch();
  }
}

void loop() {
  static uint32_t last = 0;
  if (ENABLE_LOW_REGION_PROVISION && Serial.available()) {
    char c = (char)Serial.read();
    if (c == 'P' || c == 'p') {
      provisionLowRegionPatch();
    }
    if (c == 'T' || c == 't') {
      printTpsUpdates = !printTpsUpdates;
      Serial.printf("TPS updates: %s\n", printTpsUpdates ? "ON" : "OFF");
    }
    if (c == 'B' || c == 'b') {
      printBqUpdates = !printBqUpdates;
      Serial.printf("BQ updates: %s\n", printBqUpdates ? "ON" : "OFF");
    }
    if (c == 'A' || c == 'a') {
      if (enableBqAdc()) {
        Serial.println("BQ ADC enabled.");
      } else {
        Serial.println("BQ ADC enable failed.");
      }
    }
    if (c == 'Q' || c == 'q') {
      uint8_t regs[7] = {0};
      if (readBqStatusViaTps(regs, sizeof(regs))) {
        Serial.println("---- BQ status via TPS ----");
        printBqStatusFromRegs(regs, sizeof(regs));
      }
    }
  }
  if (millis() - last < POLL_INTERVAL_MS) {
    delay(5);
    return;
  }
  last = millis();

  if (printTpsUpdates || printBqUpdates) {
    Serial.println();
    Serial.println("---- Charger/PD status ----");
  }

  if (printBqUpdates) {
    if (bqPresent) {
      printBqStatus();
    } else {
      Serial.println("BQ25792: not detected");
    }
  }

  if (printTpsUpdates) {
    if (tpsPresent) {
      printTpsStatus();
    } else {
      Serial.println("TPS25751: not detected");
    }
  }
}


