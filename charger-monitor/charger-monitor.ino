#include <Arduino.h>
#include <Wire.h>

// Low-region patch bundle generated by TI tool (I2Ct patch burst data).
// The .c file should live next to this .ino and will be compiled separately.
extern const char tps25750x_lowRegion_i2c_array[];
extern int gSizeLowRegionArray;

// ---------------- User configuration ----------------
// I2C pins (ESP32 default is SDA=21, SCL=22). Override if needed.
static const int I2C_SDA_PIN = 21;
static const int I2C_SCL_PIN = 22;
static const uint32_t I2C_CLOCK_HZ = 400000;

// BQ25792 fixed 7-bit I2C address per datasheet.
static const uint8_t BQ25792_ADDR = 0x6B;

// TPS25751 I2C target address depends on ADCIN1/2 strap (0x20-0x23).
// Set AUTO_DETECT_TPS25751 = true to probe 0x20..0x23 and use the first found.
static const uint8_t TPS25751_DEFAULT_ADDR = 0x22;
static const bool AUTO_DETECT_TPS25751 = true;
static const uint8_t TPS25751_ADDR_CANDIDATES[] = {0x20, 0x21, 0x22, 0x23};

// Poll interval
static const uint32_t POLL_INTERVAL_MS = 1000;

// Optional I2C scan and EEPROM probe (on the bus you are connected to).
static const bool ENABLE_I2C_SCAN = true;
static const uint8_t EEPROM_ADDR = 0x50;
static const bool PROBE_EEPROM = true;
static const uint16_t EEPROM_PROBE_ADDR = 0x0000;
static const uint8_t EEPROM_PROBE_LEN = 16;

// Low-region patch provisioning over I2Ct (Patch Burst Mode).
static const bool ENABLE_LOW_REGION_PROVISION = true;
static const bool PROVISION_ON_BOOT = false;
static const uint8_t PATCH_TARGET_ADDR = 0x30; // Must not conflict with any I2Ct target.
static const uint8_t PATCH_TIMEOUT_100MS = 0x32; // 0x32 = 5 seconds.
static const uint8_t PATCH_CHUNK_BYTES = 32;
// ----------------------------------------------------

static uint8_t tpsAddr = TPS25751_DEFAULT_ADDR;
static bool tpsPresent = false;
static bool bqPresent = false;
static bool printTpsUpdates = false;
static bool printBqUpdates = false;
static uint32_t lastI2CrMs = 0;

static const uint8_t *const LOW_REGION_DATA =
    reinterpret_cast<const uint8_t *>(tps25750x_lowRegion_i2c_array);
static const size_t LOW_REGION_SIZE = (size_t)gSizeLowRegionArray;

static void printHexBytes(const uint8_t *buf, size_t len) {
  for (size_t i = 0; i < len; ++i) {
    if (i > 0) {
      Serial.print(' ');
    }
    if (buf[i] < 0x10) {
      Serial.print('0');
    }
    Serial.print(buf[i], HEX);
  }
}

static bool probeAddress(uint8_t addr) {
  Wire.beginTransmission(addr);
  return Wire.endTransmission() == 0;
}

static void scanI2CBus() {
  Serial.println("I2C scan:");
  bool any = false;
  for (uint8_t addr = 0x03; addr <= 0x77; ++addr) {
    if (probeAddress(addr)) {
      Serial.printf("  - 0x%02X\n", addr);
      any = true;
    }
  }
  if (!any) {
    Serial.println("  (no devices found)");
  }
}

static bool readEepromBytes(uint8_t addr, uint16_t memAddr, uint8_t *out, size_t len) {
  Wire.beginTransmission(addr);
  Wire.write((uint8_t)(memAddr >> 8));
  Wire.write((uint8_t)(memAddr & 0xFF));
  if (Wire.endTransmission(false) != 0) {
    return false;
  }
  if (Wire.requestFrom((int)addr, (int)len) != (int)len) {
    return false;
  }
  for (size_t i = 0; i < len; ++i) {
    out[i] = Wire.read();
  }
  return true;
}

static bool readBqReg(uint8_t reg, uint8_t &value) {
  Wire.beginTransmission(BQ25792_ADDR);
  Wire.write(reg);
  if (Wire.endTransmission(false) != 0) {
    return false;
  }
  if (Wire.requestFrom((int)BQ25792_ADDR, 1) != 1) {
    return false;
  }
  value = Wire.read();
  return true;
}

static bool writeBqReg(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(BQ25792_ADDR);
  Wire.write(reg);
  Wire.write(value);
  return Wire.endTransmission() == 0;
}

static bool readBqReg16(uint8_t reg, uint16_t &value) {
  Wire.beginTransmission(BQ25792_ADDR);
  Wire.write(reg);
  if (Wire.endTransmission(false) != 0) {
    return false;
  }
  if (Wire.requestFrom((int)BQ25792_ADDR, 2) != 2) {
    return false;
  }
  uint8_t lo = Wire.read();
  uint8_t hi = Wire.read();
  value = (uint16_t)lo | ((uint16_t)hi << 8);
  return true;
}

static bool enableBqAdc() {
  uint8_t reg2e = 0;
  uint8_t reg2f = 0;
  uint8_t reg30 = 0;
  if (!readBqReg(0x2E, reg2e) ||
      !readBqReg(0x2F, reg2f) ||
      !readBqReg(0x30, reg30)) {
    return false;
  }

  // ADC_EN=1, ADC_RATE=0 (continuous), ADC_SAMPLE=00 (15-bit), ADC_AVG=0.
  reg2e &= ~(0x7F);
  reg2e |= 0x80;

  // Ensure ADC channels we care about are enabled (clear disable bits).
  reg2f &= ~(0xF8); // IBUS/IBAT/VBUS/VBAT/VSYS enable.
  reg30 &= ~(0x30); // VAC1/VAC2 enable.

  if (!writeBqReg(0x2E, reg2e) ||
      !writeBqReg(0x2F, reg2f) ||
      !writeBqReg(0x30, reg30)) {
    return false;
  }
  return true;
}

static bool readTpsRegister(uint8_t reg, uint8_t *buf, size_t expectedLen,
                            uint8_t &actualLen) {
  Wire.beginTransmission(tpsAddr);
  Wire.write(reg);
  if (Wire.endTransmission(false) != 0) {
    return false;
  }

  const size_t toRead = 1 + expectedLen;
  size_t got = Wire.requestFrom((int)tpsAddr, (int)toRead);
  if (got < 1) {
    return false;
  }

  uint8_t count = Wire.read();
  actualLen = (count < expectedLen) ? count : expectedLen;
  for (uint8_t i = 0; i < actualLen; ++i) {
    if (!Wire.available()) {
      return false;
    }
    buf[i] = Wire.read();
  }

  while (Wire.available()) {
    Wire.read();
  }

  return true;
}

static bool readTpsRegisterRaw(uint8_t reg, uint8_t *buf, size_t len) {
  Wire.beginTransmission(tpsAddr);
  Wire.write(reg);
  if (Wire.endTransmission(false) != 0) {
    return false;
  }
  size_t got = Wire.requestFrom((int)tpsAddr, (int)len);
  if (got != len) {
    return false;
  }
  for (size_t i = 0; i < len; ++i) {
    buf[i] = Wire.read();
  }
  return true;
}

static bool readBqStatusViaTps(uint8_t *regs, size_t len) {
  if (!tpsPresent) {
    Serial.println("BQ via TPS: TPS25751 not detected.");
    return false;
  }
  if (len == 0) {
    return false;
  }
  uint32_t now = millis();
  if (now - lastI2CrMs < 5000) {
    Serial.printf("BQ via TPS: wait %lu ms before next I2Cr\n",
                  (unsigned long)(5000 - (now - lastI2CrMs)));
    return false;
  }

  uint8_t data1[3] = {0};
  data1[0] = BQ25792_ADDR & 0x7F;
  data1[1] = 0x1B;
  data1[2] = (uint8_t)len;
  if (!writeTpsData1(data1, sizeof(data1))) {
    Serial.println("BQ via TPS: DATA1 write failed");
    return false;
  }
  if (!writeTpsCmd4cc("I2Cr")) {
    Serial.println("BQ via TPS: CMD1 write failed");
    return false;
  }
  if (!waitTpsCmdComplete(6000)) {
    Serial.println("BQ via TPS: CMD1 did not complete");
    return false;
  }

  uint8_t out[1 + 16] = {0};
  if (!readTpsData1(out, 1 + len)) {
    Serial.println("BQ via TPS: DATA1 read failed");
    return false;
  }
  uint8_t rc = out[0];
  if (rc != 0x00) {
    Serial.printf("BQ via TPS: return code 0x%02X\n", rc);
    return false;
  }

  memcpy(regs, out + 1, len);
  lastI2CrMs = now;
  return true;
}

static void printBqStatusFromRegs(const uint8_t *regs, size_t len) {
  if (len < 7) {
    Serial.println("BQ25792: insufficient data");
    return;
  }
  uint8_t reg1b = regs[0];
  uint8_t reg1c = regs[1];
  uint8_t reg1d = regs[2];
  uint8_t reg1e = regs[3];
  uint8_t reg1f = regs[4];
  uint8_t reg20 = regs[5];
  uint8_t reg21 = regs[6];

  Serial.println("BQ25792:");
  Serial.printf("  REG1B Status0: 0x%02X\n", reg1b);
  Serial.printf("    VBUS_PRESENT=%u AC1_PRESENT=%u AC2_PRESENT=%u PG=%u POORSRC=%u WD=%u VINDPM=%u IINDPM=%u\n",
                reg1b & 0x01, (reg1b >> 1) & 0x01, (reg1b >> 2) & 0x01, (reg1b >> 3) & 0x01,
                (reg1b >> 4) & 0x01, (reg1b >> 5) & 0x01, (reg1b >> 6) & 0x01, (reg1b >> 7) & 0x01);

  Serial.printf("  REG1C Status1: 0x%02X\n", reg1c);
  Serial.printf("    CHG_STAT=%s VBUS_STAT=%s BC1.2_DONE=%u\n",
                bqChgStatStr((reg1c >> 5) & 0x07),
                bqVbusStatStr((reg1c >> 1) & 0x0F),
                reg1c & 0x01);

  Serial.printf("  REG1D Status2: 0x%02X\n", reg1d);
  Serial.printf("    ICO=%s TREG=%u DPDM=%u VBAT_PRESENT=%u\n",
                bqIcoStatStr((reg1d >> 6) & 0x03),
                (reg1d >> 2) & 0x01,
                (reg1d >> 1) & 0x01,
                reg1d & 0x01);

  Serial.printf("  REG1E Status3: 0x%02X\n", reg1e);
  Serial.printf("    ACRB2=%u ACRB1=%u ADC_DONE=%u VSYS_STAT=%u CHG_TMR=%u TRICHG_TMR=%u PRECHG_TMR=%u\n",
                (reg1e >> 7) & 0x01, (reg1e >> 6) & 0x01, (reg1e >> 5) & 0x01, (reg1e >> 4) & 0x01,
                (reg1e >> 3) & 0x01, (reg1e >> 2) & 0x01, (reg1e >> 1) & 0x01);

  Serial.printf("  REG1F Status4: 0x%02X\n", reg1f);
  Serial.printf("    VBATOTG_LOW=%u TS_COLD=%u TS_COOL=%u TS_WARM=%u TS_HOT=%u\n",
                (reg1f >> 4) & 0x01, (reg1f >> 3) & 0x01, (reg1f >> 2) & 0x01,
                (reg1f >> 1) & 0x01, reg1f & 0x01);

  Serial.printf("  REG20 Fault0: 0x%02X\n", reg20);
  Serial.printf("    IBAT_REG=%u VBUS_OVP=%u VBAT_OVP=%u IBUS_OCP=%u IBAT_OCP=%u CONV_OCP=%u VAC2_OVP=%u VAC1_OVP=%u\n",
                (reg20 >> 7) & 0x01, (reg20 >> 6) & 0x01, (reg20 >> 5) & 0x01, (reg20 >> 4) & 0x01,
                (reg20 >> 3) & 0x01, (reg20 >> 2) & 0x01, (reg20 >> 1) & 0x01, reg20 & 0x01);

  Serial.printf("  REG21 Fault1: 0x%02X\n", reg21);
  Serial.printf("    VSYS_SHORT=%u VSYS_OVP=%u OTG_OVP=%u OTG_UVP=%u TSHUT=%u\n",
                (reg21 >> 7) & 0x01, (reg21 >> 6) & 0x01, (reg21 >> 5) & 0x01,
                (reg21 >> 4) & 0x01, (reg21 >> 2) & 0x01);
}

static bool writeTpsRegister(uint8_t reg, const uint8_t *data, size_t len) {
  if (len > 255) {
    return false;
  }
  Wire.beginTransmission(tpsAddr);
  Wire.write(reg);
  Wire.write((uint8_t)len);
  Wire.write(data, len);
  return Wire.endTransmission() == 0;
}

static bool readTpsCmd(uint8_t out[4]) {
  uint8_t actual = 0;
  if (!readTpsRegister(0x08, out, 4, actual) || actual < 4) {
    return false;
  }
  return true;
}

static bool tpsCmdIsZero(const uint8_t cmd[4]) {
  return cmd[0] == 0 && cmd[1] == 0 && cmd[2] == 0 && cmd[3] == 0;
}

static bool tpsCmdIsBangCmd(const uint8_t cmd[4]) {
  return cmd[0] == '!' && cmd[1] == 'C' && cmd[2] == 'M' && cmd[3] == 'D';
}

static bool waitTpsCmdComplete(uint32_t timeoutMs) {
  uint32_t start = millis();
  uint8_t cmd[4] = {0};
  while (millis() - start < timeoutMs) {
    if (!readTpsCmd(cmd)) {
      return false;
    }
    if (tpsCmdIsZero(cmd)) {
      return true;
    }
    if (tpsCmdIsBangCmd(cmd)) {
      return false;
    }
    delay(10);
  }
  return false;
}

static bool writeTpsCmd4cc(const char cmd[4]) {
  return writeTpsRegister(0x08, (const uint8_t *)cmd, 4);
}

static bool writeTpsData1(const uint8_t *data, size_t len) {
  return writeTpsRegister(0x09, data, len);
}

static bool readTpsData1(uint8_t *out, size_t len) {
  uint8_t actual = 0;
  if (!readTpsRegister(0x09, out, len, actual) || actual < len) {
    return false;
  }
  return true;
}

static bool tpsStartPatchBurst(uint32_t bundleSize, uint8_t patchTarget) {
  uint8_t data1[7] = {0};
  data1[0] = (uint8_t)(bundleSize & 0xFF);
  data1[1] = (uint8_t)((bundleSize >> 8) & 0xFF);
  data1[2] = (uint8_t)((bundleSize >> 16) & 0xFF);
  data1[3] = (uint8_t)((bundleSize >> 24) & 0xFF);
  data1[5] = patchTarget & 0x7F;
  data1[6] = PATCH_TIMEOUT_100MS & 0x3F;

  if (!writeTpsData1(data1, sizeof(data1))) {
    Serial.println("PBMs: DATA1 write failed");
    return false;
  }
  if (!writeTpsCmd4cc("PBMs")) {
    Serial.println("PBMs: CMD1 write failed");
    return false;
  }
  if (!waitTpsCmdComplete(2000)) {
    Serial.println("PBMs: CMD1 did not complete");
    return false;
  }

  uint8_t out[8] = {0};
  if (!readTpsData1(out, sizeof(out))) {
    Serial.println("PBMs: DATA1 read failed");
    return false;
  }
  uint8_t status = out[0];
  Serial.printf("PBMs status: 0x%02X\n", status);
  return status == 0x00;
}

static bool tpsCompletePatchBurst() {
  if (!writeTpsCmd4cc("PBMc")) {
    Serial.println("PBMc: CMD1 write failed");
    return false;
  }
  if (!waitTpsCmdComplete(5000)) {
    Serial.println("PBMc: CMD1 did not complete");
    return false;
  }

  uint8_t out[16] = {0};
  if (!readTpsData1(out, sizeof(out))) {
    Serial.println("PBMc: DATA1 read failed");
    return false;
  }

  uint8_t taskReturn = out[0];
  uint8_t devicePatchStatus = out[2];
  uint8_t appConfigStatus = out[3];
  Serial.printf("PBMc return: 0x%02X devicePatch=0x%02X appConfig=0x%02X\n",
                taskReturn, devicePatchStatus, appConfigStatus);
  return devicePatchStatus == 0x00;
}

static bool sendPatchBurstData(const uint8_t *data, size_t len, uint8_t patchTarget) {
  size_t offset = 0;
  while (offset < len) {
    size_t chunk = len - offset;
    if (chunk > PATCH_CHUNK_BYTES) {
      chunk = PATCH_CHUNK_BYTES;
    }
    Wire.beginTransmission(patchTarget);
    Wire.write(data + offset, chunk);
    if (Wire.endTransmission() != 0) {
      Serial.printf("Patch burst NACK at offset %u\n", (unsigned int)offset);
      return false;
    }
    offset += chunk;
    if ((offset % 1024) == 0) {
      Serial.printf("Patch burst: %u/%u bytes\n",
                    (unsigned int)offset, (unsigned int)len);
    }
    delay(2);
  }
  return true;
}

static void provisionLowRegionPatch() {
  if (!tpsPresent) {
    Serial.println("Provision: TPS25751 not detected.");
    return;
  }
  if (PATCH_TARGET_ADDR == tpsAddr) {
    Serial.println("Provision: PATCH_TARGET_ADDR conflicts with TPS I2Ct address.");
    return;
  }
  if (probeAddress(PATCH_TARGET_ADDR)) {
    Serial.printf("Provision: PATCH_TARGET_ADDR 0x%02X already in use.\n", PATCH_TARGET_ADDR);
    return;
  }

  uint8_t mode[4] = {0};
  uint8_t actual = 0;
  if (!readTpsRegister(0x03, mode, 4, actual) || actual < 4) {
    Serial.println("Provision: failed to read MODE.");
    return;
  }
  if (memcmp(mode, "APP ", 4) == 0) {
    Serial.println("Provision: TPS is in APP mode; PBMs will be rejected.");
    return;
  }

  Serial.printf("Provision: sending low-region bundle (%u bytes) to 0x%02X\n",
                (unsigned int)LOW_REGION_SIZE, PATCH_TARGET_ADDR);

  if (!tpsStartPatchBurst((uint32_t)LOW_REGION_SIZE, PATCH_TARGET_ADDR)) {
    Serial.println("Provision: PBMs failed.");
    return;
  }
  if (!sendPatchBurstData(LOW_REGION_DATA, LOW_REGION_SIZE, PATCH_TARGET_ADDR)) {
    Serial.println("Provision: burst write failed.");
    return;
  }
  if (!tpsCompletePatchBurst()) {
    Serial.println("Provision: PBMc reported failure.");
    return;
  }
  Serial.println("Provision: low-region patch complete.");
}

static uint64_t leBytesToU64(const uint8_t *buf, size_t len) {
  uint64_t value = 0;
  for (size_t i = 0; i < len; ++i) {
    value |= ((uint64_t)buf[i]) << (8 * i);
  }
  return value;
}

